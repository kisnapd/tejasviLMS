{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tejasvi",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "port": 3000
    },
    {
      "name": "tejasvi-dev",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "APP_URL=http://localhost:3100 NEXT_TELEMETRY_DISABLED=1 npx next dev -p 3100"
      ],
      "port": 3100
    }
  ]
}